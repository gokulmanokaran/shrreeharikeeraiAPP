# ─── Frontend (Vite / Browser) ────────────────────────────────────────────────

# Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay Live/Test Key ID (public — safe to expose in browser)
VITE_RAZORPAY_KEY_ID=rzp_test_TU0lWbkyOmj5C5

# Google Sheets Order Webhook URL (Google Apps Script Web App)
VITE_ORDER_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Supabase Database
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Backend / Vercel Serverless (Server-only — NEVER expose to browser) ──────

# Razorpay Secret Key — used by /api/process-payment for signature verification
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook Secret — set in Razorpay Dashboard → Settings → Webhooks
# Used by /api/razorpay-webhook for X-Razorpay-Signature header verification
# Generate a strong random secret (e.g. openssl rand -hex 32)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Google Sheets Webhook URL (same as VITE_ORDER_WEBHOOK_URL but for server-side use)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Supabase (server-side, using service role key for full DB access)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Firebase Phone Authentication (SMS OTP) ─────────────────────────────────
# Used ONLY for sending / verifying OTP SMS on mobile number at checkout.
# Supabase remains the primary auth and database system.
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# These are PUBLIC — safe to expose in frontend (VITE_ prefix)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
